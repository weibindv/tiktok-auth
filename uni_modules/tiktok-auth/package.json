{
  "id": "tiktok-auth",
  "displayName": "tiktok-auth",
  "version": "1.4.0",
  "description": "TikTok 授权登录 + 分享插件（Android / iOS），基于 TikTok OpenSDK 官方 SDK。登录：客户端获取 authCode，服务端换取 access_token；分享：将图片/视频先保存到系统相册/MediaStore 后拉起 TikTok 分享。",
  "keywords": [
    "TikTok",
    "登录",
    "授权",
    "分享",
    "Share Kit",
    "OAuth"
  ],
  "repository": "",
