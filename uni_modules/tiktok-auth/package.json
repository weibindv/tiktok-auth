        "price": "0.01"
      },
      "sourcecode": {
        "price": "199.00"
      }
    },
    "contact": {
      "qq": "278715441@qq.com"
    },
    "declaration": {
      "ads": "无",
      "data": "本插件用于 TikTok 授权登录（获取用户公开资料头像/昵称/open_id，客户端仅持有 auth_code，由服务端换取 access_token）与分享（仅在用户主动发起分享时，将所选图片/视频保存到系统相册/MediaStore 后拉起 TikTok）。",
      "permissions": "无"
    },
